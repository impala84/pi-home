#!/usr/bin/env bash
set -euo pipefail

app_dir=/opt/pi-bus-time-display
user_file=/etc/pi-bus-time-display/display-user
service=/etc/systemd/system/pi-bus-native.service
transform_file=/etc/pi-bus-time-display/display-transform
profile_file=/etc/pi-bus-time-display/display-profile
orientation_file=/etc/pi-bus-time-display/display-orientation
input_rules=/etc/udev/rules.d/99-pi-bus-kiosk-input.rules
reboot_marker=/var/lib/pi-bus-time-display/reboot-required-boot-id

install_service() {
  local display_user=$1
  sed "s/@DISPLAY_USER@/${display_user}/g" "${app_dir}/systemd/pi-bus-native.service.in" >"${service}.tmp"
  install -m 0644 "${service}.tmp" "${service}"
  rm -f "${service}.tmp"
  systemctl daemon-reload
}

set_boot_rotation() {
  local transform=$1
  local profile=${2:-original}
  local cmdline=/boot/firmware/cmdline.txt
  [[ -f ${cmdline} ]] || cmdline=/boot/cmdline.txt
  if [[ ! -f ${cmdline} ]]; then
    echo "Could not find the Raspberry Pi kernel command line."
    exit 1
  fi
  [[ -f ${cmdline}.pi-bus-backup ]] || cp "${cmdline}" "${cmdline}.pi-bus-backup"
  local current='' token
  for token in $(<"${cmdline}"); do
    case ${token} in
      video=DSI-*|quiet|logo.nologo|vt.global_cursor_default=*|loglevel=*|systemd.show_status=*) ;;
      *) current+=" ${token}" ;;
    esac
  done
  current=${current# }
  local mode=800x480
  [[ ${profile} =~ ^touch2-(5|7|5-7)$ ]] && mode=720x1280
  [[ ${profile} == touch2-10 ]] && mode=1200x1920
  # Kernel rotation owns the boot console; Touch Display 2 additionally needs
  # a Cage/Wayland transform once the graphical kiosk starts.
  printf '%s quiet loglevel=3 logo.nologo vt.global_cursor_default=0 systemd.show_status=false video=DSI-1:%s@60,rotate=%s\n' "${current}" "${mode}" "${transform/normal/0}" >"${cmdline}.tmp"
  install -m 0644 "${cmdline}.tmp" "${cmdline}"
  rm -f "${cmdline}.tmp"
}

configure_input() {
  local transform=$1
  local profile=${2:-original}
  local matrix
  case ${transform} in
    # Cage rotates the logical output in the opposite quarter-turn direction,
    # so touch uses the inverse matrix once (without an additional WL_OUTPUT).
    90) matrix='0 1 0 -1 0 1' ;;
    180) matrix='-1 0 1 0 -1 1' ;;
    270) matrix='0 -1 1 1 0 0' ;;
    *) matrix='1 0 0 0 1 0' ;;
  esac
  # Touch Display 2 rotation is configured in its Device Tree overlay below.
  # Leaving a second libinput matrix in place would rotate the coordinates twice.
  [[ ${profile} == touch2-* ]] && matrix='1 0 0 0 1 0'
  {
    echo 'ACTION=="remove", GOTO="pi_bus_input_end"'
    # Apply rotation in one place. WL_OUTPUT mapping can cause the compositor
    # to transform the same coordinates a second time on Touch Display 2.
    echo "ENV{ID_INPUT_TOUCHSCREEN}==\"1\", ENV{LIBINPUT_CALIBRATION_MATRIX}=\"${matrix}\""
    echo 'LABEL="pi_bus_input_end"'
  } >"${input_rules}.tmp"
  install -m 0644 "${input_rules}.tmp" "${input_rules}"
  rm -f "${input_rules}.tmp"
  udevadm control --reload-rules
  udevadm trigger --subsystem-match=input
}

configure_touch2_overlay() {
  local profile=$1
  local transform=$2
  [[ ${profile} == touch2-* ]] || return 0
  local boot_config=/boot/firmware/config.txt
  [[ -f ${boot_config} ]] || boot_config=/boot/config.txt
  [[ -f ${boot_config} ]] || { echo "Could not find Raspberry Pi boot configuration."; exit 1; }
  local overlay
  case ${profile} in
    touch2-5) overlay=vc4-kms-dsi-ili9881-5inch ;;
    touch2-10) overlay=vc4-kms-dsi-ili79600-10-1inch ;;
    *) overlay=vc4-kms-dsi-ili9881-7inch ;;
  esac
  local flags=''
  case ${transform} in
    90) flags=',swapxy,invx' ;;
    180) flags=',invx,invy' ;;
    270) flags=',swapxy,invy' ;;
  esac
  [[ -f ${boot_config}.pi-bus-touch-backup ]] || cp "${boot_config}" "${boot_config}.pi-bus-touch-backup"
  awk '
    /^# BEGIN PI HOME TOUCH DISPLAY$/ { managed=1; next }
    /^# END PI HOME TOUCH DISPLAY$/ { managed=0; next }
    managed { next }
    /^[[:space:]]*display_auto_detect=1[[:space:]]*$/ { print "display_auto_detect=0"; next }
    /^[[:space:]]*dtoverlay=vc4-kms-dsi-(ili9881-(5|7)inch|ili79600-10-1inch)/ { next }
    { print }
  ' "${boot_config}" >"${boot_config}.tmp"
  {
    printf '\n# BEGIN PI HOME TOUCH DISPLAY\n'
    printf '[all]\n'
    printf 'disable_splash=1\n'
    printf 'dtoverlay=%s%s\n' "${overlay}" "${flags}"
    printf '# END PI HOME TOUCH DISPLAY\n'
  } >>"${boot_config}.tmp"
  if ! cmp -s "${boot_config}.tmp" "${boot_config}"; then
    install -m 0755 -d "$(dirname "${reboot_marker}")"
    cat /proc/sys/kernel/random/boot_id >"${reboot_marker}"
    install -m 0644 "${boot_config}.tmp" "${boot_config}"
  fi
  rm -f "${boot_config}.tmp"
}

if [[ ${EUID} -ne 0 ]]; then
  echo "Run with sudo: sudo pi-bus-appliance-mode enable"
  exit 1
fi

case ${1:-} in
  enable)
    display_user=${SUDO_USER:-}
    if [[ -z ${display_user} || ${display_user} == root ]]; then
      [[ -f ${user_file} ]] && display_user=$(<"${user_file}")
    fi
    if [[ -z ${display_user} || ${display_user} == root ]] || ! id "${display_user}" >/dev/null 2>&1; then
      echo "Run this once with sudo from the Raspberry Pi desktop user."
      exit 1
    fi
    apt-get update
    apt-get install -y cage wlr-randr
    install -d -m 0755 /etc/pi-bus-time-display
    printf '%s\n' "${display_user}" >"${user_file}"
    [[ -f ${transform_file} ]] || printf '180\n' >"${transform_file}"
    [[ -f ${profile_file} ]] || printf 'original\n' >"${profile_file}"
    set_boot_rotation "$(<"${transform_file}")" "$(<"${profile_file}")"
    configure_input "$(<"${transform_file}")" "$(<"${profile_file}")"
    configure_touch2_overlay "$(<"${profile_file}")" "$(<"${transform_file}")"
    install_service "${display_user}"
    systemctl enable pi-bus-native.service
    systemctl disable display-manager.service >/dev/null 2>&1 || true
    systemctl set-default multi-user.target
    echo "Appliance mode enabled. Reboot to start Pi Bus without the desktop."
    ;;
  disable)
    systemctl disable pi-bus-native.service >/dev/null 2>&1 || true
    systemctl set-default graphical.target
    systemctl enable display-manager.service >/dev/null 2>&1 || true
    echo "Desktop mode restored. Reboot to apply it."
    ;;
  rotate)
    transform=${2:-}
    if [[ ! ${transform} =~ ^(normal|90|180|270)$ ]]; then
      echo "Rotation must be normal, 90, 180 or 270."
      exit 2
    fi
    printf '%s\n' "${transform}" >"${transform_file}"
    [[ -f ${profile_file} ]] || printf 'original\n' >"${profile_file}"
    set_boot_rotation "${transform}" "$(<"${profile_file}")"
    configure_input "${transform}" "$(<"${profile_file}")"
    configure_touch2_overlay "$(<"${profile_file}")" "${transform}"
    display_user=$(<"${user_file}")
    install_service "${display_user}"
    [[ ${PI_HOME_NO_RESTART:-0} == 1 ]] || systemctl restart pi-bus-native.service
    echo "Display rotation set to ${transform}."
    ;;
  display)
    profile=${2:-}
    transform=${3:-}
    if [[ ! ${profile} =~ ^(original|touch2-5|touch2-7|touch2-5-7|touch2-10)$ ]]; then
      echo "Unknown display profile."
      exit 2
    fi
    if [[ ! ${transform} =~ ^(normal|90|180|270)$ ]]; then
      echo "Rotation must be normal, 90, 180 or 270."
      exit 2
    fi
    printf '%s\n' "${profile}" >"${profile_file}"
    printf '%s\n' "${transform}" >"${transform_file}"
    if [[ ${profile} == touch2-* ]]; then
      [[ ${transform} == normal || ${transform} == 180 ]] && printf 'portrait\n' >"${orientation_file}" || printf 'landscape\n' >"${orientation_file}"
    else
      [[ ${transform} == 90 || ${transform} == 270 ]] && printf 'portrait\n' >"${orientation_file}" || printf 'landscape\n' >"${orientation_file}"
    fi
    set_boot_rotation "${transform}" "${profile}"
    configure_input "${transform}" "${profile}"
    configure_touch2_overlay "${profile}" "${transform}"
    if [[ ${PI_HOME_NO_RESTART:-0} != 1 ]] && systemctl is-enabled --quiet pi-bus-native.service; then
      systemctl restart pi-bus-native.service
    fi
    echo "Display profile set to ${profile}, rotation ${transform}."
    ;;
  status)
    echo "Default boot: $(systemctl get-default)"
    systemctl is-enabled pi-bus-native.service 2>/dev/null || true
    ;;
  *)
    echo "Usage: sudo pi-bus-appliance-mode enable|disable|status|rotate <orientation>|display <profile> <orientation>"
    exit 2
    ;;
esac
