#!/usr/bin/env python3
"""Execute a tightly-scoped privileged request from the Pi Bus admin service."""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

STATE = Path("/var/lib/pi-bus-time-display")
REQUEST = STATE / "system-action-request.json"
QUEUE = STATE / "system-action-queue"
STATUS = STATE / "system-action-status"
UPDATE_STATUS = STATE / "update-status"
LEDS_ENABLED = STATE / "leds-enabled"


def report(message: str) -> None:
    temporary = STATUS.with_suffix(".tmp")
    temporary.write_text(message + "\n", encoding="utf-8")
    os.chmod(temporary, 0o644)
    temporary.replace(STATUS)


def report_update(message: str) -> None:
    temporary = UPDATE_STATUS.with_suffix(".tmp")
    temporary.write_text(message + "\n", encoding="utf-8")
    os.chmod(temporary, 0o644)
    temporary.replace(UPDATE_STATUS)


def run(command: list[str]) -> None:
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    output = result.stdout.strip()
    if output:
        print(output, flush=True)
    if result.returncode:
        lines = [line.strip() for line in output.splitlines() if line.strip()]
        detail = lines[-1] if lines else f"exit status {result.returncode}"
        if "local changes" in output and "overwritten by merge" in output:
            detail = "local appliance changes blocked the update"
        raise RuntimeError(f"{Path(command[0]).name} failed: {detail}")


def roon_service() -> str:
    for name in ("roonbridge.service", "RoonBridge.service"):
        if subprocess.run(["systemctl", "cat", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            return name
    raise RuntimeError("Roon Bridge service is not installed")


def display_power(powered: bool, brightness_percent: int = 100) -> None:
    brightness_percent = max(10, min(100, int(brightness_percent)))
    # Recover a display pipeline disabled by an older Pi Home release, but
    # never disable it again: touchscreen wake events require it to stay live.
    vcgencmd = Path("/usr/bin/vcgencmd")
    if powered and vcgencmd.exists():
        subprocess.run([str(vcgencmd), "display_power", "1"], check=False)
    devices = [item for item in sorted(Path("/sys/class/backlight").glob("*")) if (item / "bl_power").exists() or (item / "brightness").exists()]
    if not devices:
        raise RuntimeError("No display backlight control was found")
    for device in devices:
        power = device / "bl_power"
        brightness_path = device / "brightness"
        if powered:
            maximum = int((device / "max_brightness").read_text(encoding="ascii")) if (device / "max_brightness").exists() else 255
            if power.exists():
                power.write_text("0", encoding="ascii")
            if brightness_path.exists():
                brightness_path.write_text(str(max(1, round(maximum * brightness_percent / 100))), encoding="ascii")
            if power.exists():
                power.write_text("0", encoding="ascii")
        else:
            # Keep the panel and touch controller powered. On the official
            # Touch Display 2, bl_power can take the assembly far enough down
            # that the contact needed to wake GTK is never delivered.
            if brightness_path.exists():
                brightness_path.write_text("0", encoding="ascii")
            elif power.exists():
                power.write_text("4", encoding="ascii")


def pi_leds() -> list[tuple[Path, str]]:
    result = []
    for device in sorted(Path("/sys/class/leds").glob("*")):
        name = device.name.lower()
        if name in {"act", "led0"}: result.append((device, "activity"))
        elif name in {"pwr", "led1"}: result.append((device, "power"))
    return result


def set_pi_leds(enabled: bool) -> None:
    devices = pi_leds()
    if not devices:
        raise RuntimeError("Raspberry Pi status LEDs were not found")
    for device, kind in devices:
        trigger = device / "trigger"
        brightness = device / "brightness"
        if trigger.exists():
            choices = trigger.read_text(encoding="ascii").replace("[", "").replace("]", "").split()
            if enabled:
                preferred = ("mmc0", "disk-activity", "heartbeat") if kind == "activity" else ("default-on",)
                selected = next((candidate for candidate in preferred if candidate in choices), None)
                if selected: trigger.write_text(selected, encoding="ascii")
            elif "none" in choices:
                trigger.write_text("none", encoding="ascii")
        if brightness.exists():
            maximum_path = device / "max_brightness"
            maximum = int(maximum_path.read_text(encoding="ascii")) if maximum_path.exists() else 1
            brightness.write_text(str(maximum if enabled else 0), encoding="ascii")


def save_led_preference(enabled: bool) -> None:
    temporary = LEDS_ENABLED.with_suffix(".tmp")
    temporary.write_text("true\n" if enabled else "false\n", encoding="ascii")
    os.chmod(temporary, 0o644)
    temporary.replace(LEDS_ENABLED)


def apply_led_preference() -> None:
    if not pi_leds():
        return
    enabled = LEDS_ENABLED.exists() and LEDS_ENABLED.read_text(encoding="ascii").strip() == "true"
    set_pi_leds(enabled)


def orientation_transform(profile: str, orientation: str) -> str:
    if orientation not in {"landscape", "portrait"}:
        raise ValueError("Invalid display orientation")
    native_portrait = profile.startswith("touch2-")
    if orientation == "portrait":
        return "normal" if native_portrait else "90"
    return "90" if native_portrait else "normal"


def execute(data: dict) -> None:
    action = data.get("action")
    report("Update · Starting…" if action == "update" else "Working…")
    if action == "update":
        report_update("Update · Starting…")
        try:
            run(["/usr/local/sbin/pi-bus-update"])
        except Exception as error:
            report_update(f"Failed: {error}")
            raise
        report("Update installed. Pi Home services restarted.")
    elif action == "reboot":
        report("Reboot requested. Pi Home is restarting…")
        run(["systemctl", "reboot"])
    elif action in {"display_on", "display_off"}:
        display_power(action == "display_on", int(data.get("brightness", 100)))
        report("Display awake." if action == "display_on" else "Display asleep.")
    elif action == "set_brightness":
        display_power(True, int(data.get("brightness", 100)))
        report("Display brightness updated.")
    elif action == "set_rotation":
        transform = str(data.get("transform", "normal"))
        if transform not in {"normal", "180"}:
            raise ValueError("Invalid display rotation")
        run(["/usr/local/sbin/pi-bus-appliance-mode", "rotate", transform])
        report("Display rotation updated.")
    elif action == "set_display":
        profile = str(data.get("profile", "original"))
        orientation = str(data.get("orientation", "landscape"))
        if profile not in {"original", "touch2-5", "touch2-7", "touch2-5-7", "touch2-10"}:
            raise ValueError("Invalid display configuration")
        transform = orientation_transform(profile, orientation)
        run(["/usr/local/sbin/pi-bus-appliance-mode", "display", profile, transform])
        report("Display settings updated.")
    elif action in {"roon_start", "roon_stop", "roon_restart"}:
        service = roon_service()
        verb = action.removeprefix("roon_")
        if action == "roon_start":
            run(["systemctl", "enable", "--now", service])
        elif action == "roon_stop":
            run(["systemctl", "disable", "--now", service])
        else:
            run(["systemctl", "restart", service])
        report(f"Roon Bridge {verb} complete.")
    elif action in {"netdata_enable", "netdata_disable"}:
        if subprocess.run(["systemctl", "cat", "netdata.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
            raise RuntimeError("Netdata is not installed")
        if action == "netdata_enable":
            run(["systemctl", "enable", "--now", "netdata.service"])
            report("Netdata is running and enabled at boot.")
        else:
            run(["systemctl", "disable", "--now", "netdata.service"])
            report("Netdata is stopped and disabled at boot.")
    elif action in {"leds_enable", "leds_disable"}:
        enabled = action == "leds_enable"
        set_pi_leds(enabled)
        save_led_preference(enabled)
        report("Pi status lights are on." if enabled else "Pi status lights are off.")
    elif action == "set_hostname":
        hostname = str(data.get("hostname", ""))
        if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", hostname):
            raise ValueError("Invalid device name")
        run(["hostnamectl", "set-hostname", hostname])
        report("Device name updated. Reboot recommended.")
    elif action == "set_wifi":
        ssid = str(data.get("ssid", ""))
        password = str(data.get("password", ""))
        if not ssid or len(ssid) > 32 or len(password) < 8:
            raise ValueError("Wi-Fi name or password is invalid")
        run(["nmcli", "device", "wifi", "connect", ssid, "password", password])
        report(f"Connected to {ssid}.")
    else:
        raise ValueError("Unknown system action")


def pending_requests() -> list[Path]:
    """Return legacy and queued requests in a stable order."""
    requests = [REQUEST] if REQUEST.exists() else []
    if QUEUE.exists():
        requests.extend(sorted(QUEUE.glob("*.json")))
    return requests


def main() -> None:
    # Keep draining until the queue is empty. Requests arriving just after the
    # final scan also update system-action-trigger, causing systemd to start a
    # fresh one-shot once this invocation exits.
    update_seen = False
    while requests := pending_requests():
        for request in requests:
            try:
                data = json.loads(request.read_text(encoding="utf-8"))
                if data.get("action") == "update":
                    if update_seen:
                        print(f"Discarding duplicate update request: {request.name}", flush=True)
                        continue
                    update_seen = True
                execute(data)
            except Exception as error:
                # One malformed or failed action must not strand later wake,
                # brightness or service requests in the queue.
                report(f"Failed: {error}")
                print(f"System action failed: {error}", file=sys.stderr, flush=True)
            finally:
                request.unlink(missing_ok=True)


if __name__ == "__main__":
    try:
        if len(sys.argv) == 2 and sys.argv[1] == "--apply-leds": apply_led_preference()
        else: main()
    except Exception as error:
        report(f"Failed: {error}")
        raise
