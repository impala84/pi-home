#!/sbin/openrc-run
description="Pi Home dashboard API"
supervisor=supervise-daemon
command=/opt/pi-bus-time-display/.venv/bin/pi-bus-time-display
command_args="--config /etc/pi-bus-time-display/config.toml --env /etc/pi-bus-time-display/secrets.env --state-dir /var/lib/pi-bus-time-display --host 0.0.0.0"
command_user=morningbus:morningbus
directory=/opt/pi-bus-time-display
respawn_delay=3
export PYTHONUNBUFFERED=1
export PI_HOME_APPLIANCE_PLATFORM=alpine-prototype
depend() { need net pi-home-firstboot; }
