#!/sbin/openrc-run
description="Pi Home native GTK touchscreen"
supervisor=supervise-daemon
command=/usr/local/bin/pi-home-display-launch
command_user=morningbus:morningbus
respawn_delay=3
respawn_max=0
output_log=/var/log/pi-home/display.log
error_log=/var/log/pi-home/display-error.log
depend() { need seatd dbus pi-home-api pi-home-roon pi-home-setup pi-home-input; after udev-trigger; }
start_pre() { checkpath -d -m 0700 -o morningbus:morningbus /run/pi-home; }
