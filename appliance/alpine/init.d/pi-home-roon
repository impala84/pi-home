#!/sbin/openrc-run
description="RoonDeck controller (Roon Bridge RAAT endpoint is optional)"
supervisor=supervise-daemon
command=/usr/bin/node
command_args=/opt/pi-home/roon-controller/server.js
command_user=morningbus:morningbus
directory=/var/lib/pi-home/roon
respawn_delay=5
respawn_max=0
output_log=/var/log/pi-home/roon.log
error_log=/var/log/pi-home/roon-error.log
export NODE_ENV=production
depend() { need pi-home-firstboot; after networkmanager; }
