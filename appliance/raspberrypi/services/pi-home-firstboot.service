[Unit]
Description=Pi Home recoverable machine provisioning
After=local-fs.target
Before=pi-bus-time-display.service pi-bus-roon-controller.service pi-bus-native.service
ConditionPathExists=!/var/lib/pi-home/raspberrypi-initialized

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pi-home/appliance/raspberrypi/firstboot.py
TimeoutStartSec=5min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
