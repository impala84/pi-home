[Unit]
Description=Pi Home Lite Cage/GTK touchscreen
After=pi-home-firstboot.service pi-home-seatd.service pi-bus-time-display.service
Requires=pi-home-seatd.service
Wants=pi-home-firstboot.service pi-bus-time-display.service pi-bus-roon-controller.service
Conflicts=getty@tty1.service

[Service]
User=morningbus
Group=morningbus
SupplementaryGroups=video render input audio
RuntimeDirectory=pi-home
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/pi-home
Environment=XDG_SESSION_TYPE=wayland
Environment=GDK_BACKEND=wayland
Environment=LIBSEAT_BACKEND=seatd
Environment=SEATD_SOCK=/run/pi-home-seatd.sock
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pi-home/appliance/raspberrypi/display-session
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
