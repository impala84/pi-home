[Unit]
Description=RoonDeck Roon touchscreen controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=morningbus
Group=morningbus
ExecStartPre=+/usr/bin/install -d -o morningbus -g morningbus /var/lib/pi-bus-time-display/roon
WorkingDirectory=/var/lib/pi-bus-time-display/roon
Environment=NODE_ENV=production
EnvironmentFile=-/etc/pi-bus-time-display/roon.env
ExecStart=/usr/bin/node /opt/pi-bus-time-display/roon-controller/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
