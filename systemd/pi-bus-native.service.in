[Unit]
Description=RoonDeck native touchscreen appliance
After=systemd-user-sessions.service network-online.target pi-bus-roon-controller.service
Wants=network-online.target pi-bus-roon-controller.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=@DISPLAY_USER@
SupplementaryGroups=input
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=GDK_BACKEND=wayland
Environment=XDG_SESSION_TYPE=wayland
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/cage -s -- /opt/pi-bus-time-display/scripts/pi-bus-cage-launch
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
